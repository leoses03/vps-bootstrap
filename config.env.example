# ============================================
# Requeridos
# ============================================
DOMAIN="example.com"
ADMIN_EMAIL="admin@example.com"

# ============================================
# WordPress
# ============================================
WP_LOCALE="es_CL"
WP_SITE_TITLE="Mi Sitio"
WP_ADMIN_USER="siteadmin"

# ============================================
# Backups (Backblaze B2)
# Si dejas B2_BUCKET vacío, se saltan los backups
# Tienes que correr `rclone config` manualmente antes
# ============================================
B2_BUCKET=""
B2_REMOTE_NAME="b2backup"
BACKUP_RETENTION_DAYS="14"

# ============================================
# Versiones y defaults
# ============================================
MARIADB_VERSION="11.4"
PHP_VERSION="82"
SWAP_GB="2"
TIMEZONE_FOR_CRON="America/Santiago"
PHP_MEMORY_LIMIT="512M"
PHP_UPLOAD_MAX="128M"
PHP_POST_MAX="128M"

# ============================================
# Flags para saltar pasos
# ============================================
SKIP_SSL="0"        # 1 = no emite Let's Encrypt (DNS aún sin propagar)
SKIP_BACKUPS="0"    # 1 = no configura B2
